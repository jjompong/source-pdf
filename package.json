{
    "name": "@pagasa-parser/source-pdf",
    "version": "1.1.9",
    "description": "Allows parsing of PAGASA TCB PDF files into pagasa-parser Bulletins.",
    "main": "build/PagasaParserPDFSource.js",
    "types": "build/PagasaParserPDFSource.d.ts",
    "files": [
        "bin",
        "build",
        "LICENSE",
        "package.json",
        "package-lock.json",
        "README.md"
    ],
    "scripts": {
        "build": "tsc",
        "test": "jest",
        "coverage": "npm run coverage:full",
        "coverage:full": "jest --coverage --collectCoverageFrom=src/**/*.{js,jsx,ts,tsx}",
        "coverage:minimal": "jest --coverage",
        "prepack": "npm run clean && npm run build",
        "clean": "rimraf build",
        "prepare": "npm run build"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/jjompong/source-pdf.git"
    },
    "keywords": [
        "scraper",
        "weather",
        "json",
        "philippines",
        "typhoon"
    ],
    "author": "Chlod Alejandro <chlod@chlod.net> (https://chlod.net)",
    "license": "Apache-2.0",
    "bugs": {
        "url": "https://github.com/jjompong/source-pdf/issues"
    },
    "homepage": "https://github.com/jjompong/source-pdf#readme",
    "engines": {
        "node": ">=13"
    },
    "devDependencies": {
        "@types/cheerio": "^0.22.30",
        "@types/jest": "^30.0.0",
        "@types/string-similarity": "^4.0.0",
        "@typescript-eslint/eslint-plugin": "^4.6.0",
        "eslint": "^7.12.1",
        "husky": "^7.0.4",
        "jest": "^30.5.2",
        "rimraf": "^3.0.2",
        "ts-jest": "^29.4.15",
        "ts-node": "^10.2.1",
        "typescript": "^5.9.3",
        "@types/node": "^22.19.0"
    },
    "peerDependencies": {
        "pagasa-parser": "^2.2.4"
    },
    "dependencies": {
        "axios": "^0.34.0"
    }
